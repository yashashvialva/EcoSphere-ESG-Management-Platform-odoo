# EcoSphere Environment Variables
# Copy this file to .env and fill in the values

# Database
DATABASE_URL=postgresql://ecosphere:ecosphere_pass@localhost:5432/ecosphere

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Server
PORT=5000
NODE_ENV=development

# Email (optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# File Upload
UPLOAD_PATH=./uploads

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
