# Database
DATABASE_URL="postgresql://username:password@localhost:5432/ecosphere"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="24h"

# Server
PORT=5000
NODE_ENV=development

# Email (optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880
