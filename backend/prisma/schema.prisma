generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTHENTICATION AND RBAC
// ============================================================

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique @db.VarChar(50)
  description String?          @db.Text
  is_active   Boolean          @default(true)
  created_at  DateTime         @default(now()) @db.Timestamp(6)
  updated_at  DateTime         @updatedAt @db.Timestamp(6)
  
  employees   Employee[]
  permissions RolePermission[]

  @@map("role")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(100)
  description String?          @db.Text
  module      String           @db.VarChar(50)
  created_at  DateTime         @default(now()) @db.Timestamp(6)
  
  roles       RolePermission[]

  @@map("permission")
}

model RolePermission {
  id            String     @id @default(uuid()) @db.Uuid
  role_id       String     @db.Uuid
  permission_id String     @db.Uuid
  created_at    DateTime   @default(now()) @db.Timestamp(6)

  role       Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([role_id, permission_id])
  @@map("role_permission")
}

model Employee {
  id            String   @id @default(uuid()) @db.Uuid
  first_name    String   @db.VarChar(100)
  last_name     String   @db.VarChar(100)
  email         String   @unique @db.VarChar(255)
  password_hash String   @db.Text
  department_id String   @db.Uuid
  role_id       String   @db.Uuid
  total_xp      Int      @default(0)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now()) @db.Timestamp(6)
  updated_at    DateTime @updatedAt @db.Timestamp(6)

  department       Department @relation(fields: [department_id], references: [id], onDelete: Restrict)
  role             Role       @relation(fields: [role_id], references: [id], onDelete: Restrict)
  
  headed_departments Department[] @relation("DepartmentHead")

  @@index([email])
  @@index([department_id])
  @@index([role_id])
  @@map("employee")
}

// ============================================================
// ORGANIZATION AND SHARED MASTER DATA
// ============================================================

model Department {
  id                   String   @id @default(uuid()) @db.Uuid
  name                 String   @db.VarChar(100)
  code                 String   @unique @db.VarChar(20)
  head_employee_id     String?  @db.Uuid
  parent_department_id String?  @db.Uuid
  employee_count       Int      @default(0)
  is_active            Boolean  @default(true)
  created_at           DateTime @default(now()) @db.Timestamp(6)
  updated_at           DateTime @updatedAt @db.Timestamp(6)

  head_employee     Employee?    @relation("DepartmentHead", fields: [head_employee_id], references: [id])
  parent_department Department?  @relation("DepartmentHierarchy", fields: [parent_department_id], references: [id])
  child_departments Department[] @relation("DepartmentHierarchy")

  employees           Employee[]
  carbon_transactions CarbonTransaction[]
  esg_goals           EsgGoal[]
  department_scores   DepartmentScore[]

  @@index([name])
  @@index([parent_department_id])
  @@map("department")
}

model Category {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @db.VarChar(100)
  type       String   @db.VarChar(50) // e.g. CSR, CHALLENGE, TRAINING
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamp(6)

  @@unique([name, type])
  @@map("category")
}

model OrganizationSetting {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(100)
  env_weight    Decimal  @default(33.33) @db.Decimal(5, 2)
  soc_weight    Decimal  @default(33.33) @db.Decimal(5, 2)
  gov_weight    Decimal  @default(33.34) @db.Decimal(5, 2)
  industry      String?  @db.VarChar(100)
  fiscal_start  String?  @db.VarChar(5) // MM-DD
  updated_at    DateTime @updatedAt @db.Timestamp(6)

  @@map("organization_setting")
}

// ============================================================
// ENVIRONMENTAL MODULE (Developer 1)
// ============================================================

model EmissionFactor {
  id          String   @id @default(uuid()) @db.Uuid
  source      String   @db.VarChar(100)
  unit        String   @db.VarChar(20)
  factor      Decimal  @db.Decimal(10, 4) // kg CO2 per unit
  description String?  @db.Text
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @updatedAt @db.Timestamp(6)

  product_esg_profiles ProductEsgProfile[]
  carbon_transactions  CarbonTransaction[]

  @@unique([source, unit])
  @@map("emission_factor")
}

model ProductEsgProfile {
  id                    String   @id @default(uuid()) @db.Uuid
  product_name          String   @db.VarChar(255)
  emission_factor_id    String   @db.Uuid
  recyclable            Boolean  @default(false)
  sustainability_rating Int      @default(3) // 1-5
  is_active             Boolean  @default(true)
  created_at            DateTime @default(now()) @db.Timestamp(6)
  updated_at            DateTime @updatedAt @db.Timestamp(6)

  emission_factor EmissionFactor @relation(fields: [emission_factor_id], references: [id], onDelete: Restrict)

  @@map("product_esg_profile")
}

model CarbonTransaction {
  id                 String   @id @default(uuid()) @db.Uuid
  department_id      String   @db.Uuid
  emission_factor_id String   @db.Uuid
  source_type        String   @db.VarChar(50) // PURCHASE, MANUFACTURING, FLEET, EXPENSE, MANUAL
  reference_id       String?  @db.VarChar(100) // Optional ERP reference
  quantity           Decimal  @db.Decimal(12, 2)
  emission_value     Decimal  @db.Decimal(12, 2) // Calculated: quantity * factor
  transaction_date   DateTime @db.Date
  created_at         DateTime @default(now()) @db.Timestamp(6)

  department      Department     @relation(fields: [department_id], references: [id], onDelete: Restrict)
  emission_factor EmissionFactor @relation(fields: [emission_factor_id], references: [id], onDelete: Restrict)

  @@index([department_id])
  @@index([transaction_date])
  @@index([source_type])
  @@map("carbon_transaction")
}

model EsgGoal {
  id             String   @id @default(uuid()) @db.Uuid
  department_id  String   @db.Uuid
  title          String   @db.VarChar(255)
  target_value   Decimal  @db.Decimal(12, 2)
  achieved_value Decimal  @default(0) @db.Decimal(12, 2)
  deadline       DateTime @db.Date
  status         String   @default("DRAFT") @db.VarChar(20) // DRAFT, ACTIVE, COMPLETED, EXPIRED
  created_at     DateTime @default(now()) @db.Timestamp(6)
  updated_at     DateTime @updatedAt @db.Timestamp(6)

  department Department @relation(fields: [department_id], references: [id], onDelete: Restrict)

  @@index([department_id])
  @@index([deadline])
  @@map("esg_goal")
}

// ============================================================
// DASHBOARD AND REPORTING (Shared/Developer 1)
// ============================================================

model DepartmentScore {
  id               String   @id @default(uuid()) @db.Uuid
  department_id    String   @db.Uuid
  calculated_date  DateTime @db.Date
  env_score        Decimal  @db.Decimal(5, 2)
  soc_score        Decimal  @db.Decimal(5, 2)
  gov_score        Decimal  @db.Decimal(5, 2)
  total_score      Decimal  @db.Decimal(5, 2)
  created_at       DateTime @default(now()) @db.Timestamp(6)

  department Department @relation(fields: [department_id], references: [id], onDelete: Cascade)

  @@unique([department_id, calculated_date])
  @@map("department_score")
}

// NOTE: Social, Governance, Gamification, and Notifications models 
// will be added by their respective developers.
